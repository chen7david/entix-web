#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "Husky: Running pre-commit hook..."

# 1. Format code
echo "Husky: Formatting code..."
npm run format
if [ $? -ne 0 ]; then
  echo "Husky: Code formatting failed."
  exit 1
fi

# 2. Lint code and attempt to fix issues
echo "Husky: Linting code and attempting fixes..."
npm run lint:fix # Using lint:fix to auto-correct issues
if [ $? -ne 0 ]; then
  echo "Husky: Linting failed."
  exit 1
fi

# 3. Build the project
echo "Husky: Building project..."
npm run build
if [ $? -ne 0 ]; then
  echo "Husky: Build failed."
  exit 1
fi

# 4. Add any changed files from formatting/linting to the commit
# This is important because format or lint:fix might have changed files.
echo "Husky: Staging changes from formatting/linting..."
git add .

# 5. Clean the build directory (as requested)
# Note: If 'build' creates 'dist', and 'clean' removes 'dist', this step
# removes build artifacts right before committing.
echo "Husky: Cleaning build directory..."
npm run clean
if [ $? -ne 0 ]; then
  echo "Husky: Clean script failed."
  exit 1
fi

echo "Husky: Pre-commit checks passed successfully."
exit 0
